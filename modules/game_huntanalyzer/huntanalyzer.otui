HuntAnalyzerStatRow < UIWidget
  height: 16
  margin-bottom: 2

HuntAnalyzerStatName < GameLabel
  id: name
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  text-align: topleft

HuntAnalyzerStatValue < GameLabel
  id: value
  font: verdana-11px-monochrome
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: parent.horizontalCenter
  text-align: topright
  color: #bbbbbb

HuntAnalyzerKillLabel < GameLabel
  height: 14
  margin-bottom: 1
  font: verdana-11px-monochrome
  text-align: topleft
  color: #bbbbbb

HuntAnalyzerKillRow < UIWidget
  height: 14
  margin-bottom: 2

  GameLabel
    id: name
    font: verdana-11px-monochrome
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    anchors.right: count.left
    margin-right: 4
    text-align: topleft
    text-wrap: true
    color: #bbbbbb

  GameLabel
    id: count
    width: 45
    font: verdana-11px-monochrome
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 8
    text-align: topright
    color: #bbbbbb

HuntAnalyzerKillSeparator < HorizontalSeparator
  height: 2
  margin-top: 1
  margin-bottom: 2

HuntAnalyzerGraphLabel < GameLabel
  font: verdana-10px
  color: #bbbbbb
  text-align: center

HuntAnalyzerGraphLine < UIWidget
  background-color: #66666666

HuntAnalyzerExpGraph < UIGraph
  padding-left: 1
  padding-right: 1
  padding-top: 5
  padding-bottom: 2
  show-labels: false
  show-info: false

MiniWindow
  id: huntAnalyzerWindow
  !text: tr('Hunt Analyzer')
  height: 344
  icon: /images/topbuttons/battle
  @onOpen: modules.game_huntanalyzer.onMiniWindowOpen()
  @onClose: modules.game_huntanalyzer.onMiniWindowClose()
  &save: true

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    Button
      id: startStopButton
      height: 22
      margin-top: 5
      margin-bottom: 5
      !text: tr('Start')
      @onClick: modules.game_huntanalyzer.onStartStopClick()

    HuntAnalyzerStatRow
      id: expGain
      HuntAnalyzerStatName
        !text: tr('Exp gain')
      HuntAnalyzerStatValue
        text: 0

    HuntAnalyzerStatRow
      id: expGainHour
      HuntAnalyzerStatName
        !text: tr('Exp gain/h')
      HuntAnalyzerStatValue
        text: 0

    HuntAnalyzerStatRow
      id: damage
      HuntAnalyzerStatName
        !text: tr('Damage')
      HuntAnalyzerStatValue
        text: 0

    HuntAnalyzerStatRow
      id: damageHour
      HuntAnalyzerStatName
        !text: tr('Damage/h')
      HuntAnalyzerStatValue
        text: 0

    Panel
      id: expGraphPanel
      height: 92
      margin-top: 4
      margin-bottom: 3
      background-color: #00000022

      Panel
        id: expGraphAxis
        width: 18
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 2
        margin-top: 14
        margin-bottom: 13

        GameLabel
          id: expGraphAxisMax
          width: 34
          height: 12
          font: verdana-10px
          color: #bbbbbb
          anchors.left: parent.left
          anchors.top: parent.top
          margin-left: -9
          rotation: -90
          text-align: center
          text: 0

        GameLabel
          id: expGraphAxisMid
          width: 34
          height: 12
          font: verdana-10px
          color: #bbbbbb
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: -9
          rotation: -90
          text-align: center
          text: 0

        GameLabel
          id: expGraphAxisMin
          width: 34
          height: 12
          font: verdana-10px
          color: #bbbbbb
          anchors.left: parent.left
          anchors.bottom: parent.bottom
          margin-left: -9
          rotation: -90
          text-align: center
          text: 0

      Panel
        id: expGraphPlot
        anchors.left: expGraphAxis.right
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 3
        margin-top: 4
        margin-right: 4
        margin-bottom: 13
        background-color: #00000033

        HuntAnalyzerGraphLine
          height: 1
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.top: parent.top

        HuntAnalyzerGraphLine
          height: 1
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter

        HuntAnalyzerGraphLine
          height: 1
          anchors.left: parent.left
          anchors.right: parent.right
          anchors.bottom: parent.bottom

        HuntAnalyzerGraphLine
          width: 1
          anchors.left: parent.left
          anchors.top: parent.top
          anchors.bottom: parent.bottom

        HuntAnalyzerGraphLine
          width: 1
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.top: parent.top
          anchors.bottom: parent.bottom

        HuntAnalyzerGraphLine
          width: 1
          anchors.right: parent.right
          anchors.top: parent.top
          anchors.bottom: parent.bottom

        HuntAnalyzerExpGraph
          id: expGraph
          anchors.fill: parent

      Panel
        id: graphTicks
        height: 12
        anchors.left: expGraphPlot.left
        anchors.right: expGraphPlot.right
        anchors.bottom: parent.bottom
        layout:
          type: horizontalBox
          spacing: 4

        GameLabel
          width: 20
          height: 12
          font: verdana-10px
          color: #bbbbbb
          text-align: center
          text: -60

        GameLabel
          width: 20
          height: 12
          font: verdana-10px
          color: #bbbbbb
          text-align: center
          text: -45

        GameLabel
          width: 20
          height: 12
          font: verdana-10px
          color: #bbbbbb
          text-align: center
          text: -30

        GameLabel
          width: 20
          height: 12
          font: verdana-10px
          color: #bbbbbb
          text-align: center
          text: -15

        GameLabel
          width: 20
          height: 12
          font: verdana-10px
          color: #bbbbbb
          text-align: center
          text: 0

    HorizontalSeparator
      id: killedSeparator
      margin-top: 4
      margin-bottom: 2

    GameLabel
      id: killsTitle
      height: 16
      margin-bottom: 2
      font: verdana-11px-monochrome
      !text: tr('Killed:')
      color: #f7f7f7

    Panel
      id: killsListBase
      height: 100

      UIScrollArea
        id: killsList
        anchors.fill: parent
        vertical-scrollbar: killsScrollbar
        padding-right: 12
        layout:
          type: verticalBox

      VerticalScrollBar
        id: killsScrollbar
        anchors.top: killsList.top
        anchors.right: killsList.right
        anchors.bottom: killsList.bottom
        step: 28
        pixel-scroll: true
