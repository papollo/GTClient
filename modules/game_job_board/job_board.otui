JobBoardOffer < Panel
  height: 116
  margin-bottom: 6
  padding: 8
  background-color: #39372F
  border-width: 1
  border-color: #665D43

  Label
    id: npc
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: accept.left
    margin-right: 8
    height: 16
    color: #D9C68C
    text-align: left

  Button
    id: accept
    anchors.top: parent.top
    anchors.right: parent.right
    width: 86
    height: 24
    @onClick: modules.game_job_board.acceptOffer(self:getParent():getId())

  Label
    id: name
    anchors.top: npc.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-right: 8
    height: 18
    color: #F1E5C2
    text-align: left
    font: verdana-11px-monochrome

  Label
    id: description
    anchors.top: name.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 22
    color: #CFCFCF
    text-align: left
    text-wrap: true

  Label
    id: requirements
    anchors.top: description.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 18
    color: #E2D5B2
    text-align: left
    text-wrap: true

  Label
    id: rewards
    anchors.top: requirements.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 16
    color: #97C77E
    text-align: left

MainWindow
  id: jobBoardWindow
  size: 570 570
  @onEscape: modules.game_job_board.close()

  Label
    id: intro
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 12
    height: 24
    color: #D9C68C
    text-align: center

  ScrollablePanel
    id: offers
    anchors.top: intro.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: feedback.top
    margin: 10
    padding-right: 12
    vertical-scrollbar: offersScrollbar
    layout:
      type: verticalBox
      spacing: 2

  VerticalScrollBar
    id: offersScrollbar
    anchors.top: offers.top
    anchors.right: offers.right
    anchors.bottom: offers.bottom
    step: 122
    pixel-scroll: true

  Label
    id: feedback
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-left: 12
    margin-right: 12
    margin-bottom: 6
    height: 20
    color: #E5B85C
    text-align: center
    visible: false

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 12
    margin-bottom: 10
    width: 82
    height: 24
    !text: tr('Zamknij')
    @onClick: modules.game_job_board.close()
