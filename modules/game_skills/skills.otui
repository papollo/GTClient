SkillFirstWidget < UIWidget

SkillButton < UIButton
  height: 21
  margin-bottom: 2
  &onClick: onSkillButtonClick

SmallSkillButton < SkillButton
  height: 14

SkillNameLabel < GameLabel
  font: verdana-11px-monochrome
  anchors.left: parent.left
  anchors.top: parent.top
  anchors.bottom: parent.bottom

SkillValueLabel < GameLabel
  id: value
  font: verdana-11px-monochrome
  text-align: topright
  anchors.right: parent.right
  anchors.top: parent.top
  anchors.bottom: parent.bottom
  anchors.left: prev.left

ImageSkill < UIWidget
  id: icon
  size: 9 9
  width: 9
  margin-top: 3
  anchors.left: parent.left
  anchors.top: parent.top
  phantom: false

RedPercentPanel < ProgressBar
  id: percent
  background-color: red
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

SkillPercentPanel < ProgressBar
  id: percent
  background-color: green
  height: 5
  margin-top: 15
  anchors.left: parent.left
  anchors.right: parent.right
  anchors.top: parent.top
  phantom: false

MiniWindow
  id: skillWindow
  !text: tr('Skills')
  height: 150
  icon: /images/topbuttons/skills
  @onOpen: modules.game_skills.onMiniWindowOpen()
  @onClose: modules.game_skills.onMiniWindowClose()
  &save: true

  MiniWindowContents
    padding-left: 5
    padding-right: 5
    layout: verticalBox

    SkillButton
      margin-top: 5
      id: experience
      height: 15
      SkillNameLabel
        !text: tr('Experience')
      SkillValueLabel
      
    SkillButton
      id: xpRate
      height: 15
      SkillNameLabel
        !text: tr('ExpRate')
      SkillValueLabel

    SkillButton
      id: level
      SkillNameLabel
        !text: tr('Level')
      SkillValueLabel
      RedPercentPanel

    SkillButton
      id: regenerationTime
      SkillNameLabel
        !text: tr('Regeneration Time')
      SkillValueLabel

    SkillButton
      id: stamina
      SkillNameLabel
        !text: tr('Stamina')
      SkillValueLabel
      RedPercentPanel

    SkillButton
      id: offlineTraining
      SkillNameLabel
        !text: tr('Offline Training')
      SkillValueLabel
      RedPercentPanel

    HorizontalSeparator
      margin-top: 5
      margin-bottom: 5

    Label
      !text: tr('FightingLabel')
      font: verdana-11px-antialised
      margin-top: 3
      margin-bottom: 3
      color: #FFFFFF
      text-align: center

    SkillButton
      id: skillId0
      height: 15
      visible: false
      SkillNameLabel
        margin-left: 12
        !text: tr('Fist Fighting')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_fist
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId2
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('One handed')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_sword
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId1
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Two handed')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_club
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId3
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Bow Fighting')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_bow
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId4
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Crossbow Fighting')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_crossbow
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId5
      height: 15
      visible: false
      SkillNameLabel
        !text: tr('Shielding')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_shielding
        image-size: 9 9
      SkillPercentPanel
    
    HorizontalSeparator
      margin-top: 5
      margin-bottom: 5

    Label
      !text: tr('SkillExperience')
      font: verdana-11px-antialised
      margin-top: 3
      margin-bottom: 3
      color: #FFFFFF
      text-align: center

    SkillButton
      id: skillId6
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Fishing')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_fishing
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId7
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Mining')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_mining
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId10
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Cooking')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_cooking
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId11
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Alchemy')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_alchemy
        image-size: 9 9
      SkillPercentPanel

    SkillButton
      id: skillId12
      height: 15
      SkillNameLabel
        margin-left: 12
        !text: tr('Smithing')
      SkillValueLabel
      ImageSkill
        image-source: /images/icons/icon_smith
