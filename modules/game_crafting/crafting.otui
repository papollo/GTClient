CraftingRecipeRow < UICheckBox
  size: 220 46
  background-color: #454545
  border-width: 1
  border-color: #303030

  UIWidget
    id: iconBackground
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    image-source: /images/ui/item

    UIItem
      id: icon
      anchors.centerIn: parent
      size: 32 32
      virtual: true
      draggable: false

  Label
    id: name
    anchors.left: iconBackground.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 7
    color: #D4D4D4
    text-align: left
    text-wrap: true

  $hover:
    background-color: #515151
    border-color: #666666

  $checked:
    background-color: #5B5B5B
    border-color: #8A8A8A

CraftingSectionLabel < Label
  height: 22
  width: 438
  color: #E0E0E0
  background-color: #3E3E3E
  padding-left: 6
  text-align: left

CraftingRequirementRow < UIWidget
  size: 438 30
  background-color: #484848

  Label
    id: name
    anchors.left: parent.left
    anchors.right: value.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 8
    color: #CFCFCF
    text-wrap: true

  Label
    id: value
    anchors.right: status.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 72
    color: #D7D7D7
    text-align: right

  Label
    id: status
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-top: 1
    margin-bottom: 1
    margin-right: 8
    width: 132
    color: #E86A6A
    text-align: right
    text-wrap: true

CraftingMaterialRow < UIWidget
  size: 438 44
  background-color: #484848

  UIWidget
    id: iconBackground
    size: 36 36
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    image-source: /images/ui/item

    UIItem
      id: icon
      anchors.centerIn: parent
      size: 32 32
      virtual: true
      draggable: false

  Label
    id: name
    anchors.left: iconBackground.right
    anchors.right: amount.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 8
    margin-right: 8
    color: #CFCFCF
    text-align: left
    text-wrap: true

  Label
    id: amount
    anchors.right: status.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 68
    color: #D7D7D7
    text-align: right

  Label
    id: status
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-top: 4
    margin-bottom: 4
    margin-right: 8
    width: 150
    color: #E86A6A
    text-align: right
    text-wrap: true

CraftingEmptyRow < Label
  size: 438 26
  color: #999999
  text-align: center

CraftingTabButton < UIButton
  size: 112 24
  background-color: #3A3A3A
  border-width: 1
  border-color: #2A2A2A
  color: #CFCFCF
  text-align: center

  $hover:
    background-color: #484848
    border-color: #606060

  $checked:
    background-color: #565656
    border-color: #8A8A8A
    color: #FFFFFF

MainWindow
  id: craftingWindow
  size: 760 520
  !text: tr('Crafting')
  @onEscape: modules.game_crafting.closeWindow()

  UIWidget
    id: contentPanel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: bottomSeparator.top
    margin-bottom: 9

    Panel
      id: craftingTabs
      height: 24
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

      CraftingTabButton
        id: recipesTab
        anchors.top: parent.top
        anchors.left: parent.left
        !text: tr('Recipes')
        checked: true
        @onClick: modules.game_crafting.selectCraftingTab('recipes')

      CraftingTabButton
        id: queueTab
        anchors.top: parent.top
        anchors.left: recipesTab.right
        margin-left: 4
        !text: tr('Queue')
        @onClick: modules.game_crafting.selectCraftingTab('queue')

    Panel
      id: recipePanel
      width: 238
      anchors.top: craftingTabs.bottom
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-top: 4
      background-color: #363636

      Label
        id: recipesTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 25
        color: #E0E0E0
        text-align: center
        !text: tr('Recipes')

      TextEdit
        id: recipeSearch
        anchors.top: recipesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        height: 22
        margin-left: 5
        margin-right: 5
        !placeholder: tr('Search')
        @onTextChange: modules.game_crafting.filterRecipes(self:getText())

      ScrollablePanel
        id: recipeList
        anchors.top: recipeSearch.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 5
        margin-left: 5
        margin-right: 5
        margin-bottom: 5
        padding-right: 14
        vertical-scrollbar: recipeScrollbar
        layout:
          type: verticalBox
          spacing: 3

      VerticalScrollBar
        id: recipeScrollbar
        anchors.top: recipeList.top
        anchors.right: recipeList.right
        anchors.bottom: recipeList.bottom
        step: 48
        pixel-scroll: true

      Label
        id: recipesEmptyLabel
        anchors.centerIn: recipeList
        width: 190
        height: 48
        color: #999999
        text-align: center
        text-wrap: true
        !text: tr('No unlocked recipes')
        visible: false

    VerticalSeparator
      id: columnSeparator
      anchors.top: craftingTabs.bottom
      anchors.bottom: parent.bottom
      anchors.left: recipePanel.right
      margin-top: 4
      margin-left: 8
      margin-right: 8

    Panel
      id: detailPanel
      anchors.top: craftingTabs.bottom
      anchors.left: columnSeparator.right
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      margin-left: 8
      background-color: #363636

      Label
        id: stationLabel
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 20
        color: #BEBEBE
        text-align: center

      Panel
        id: detailsBase
        anchors.top: stationLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 4
        background-color: #303030

        ScrollablePanel
          id: detailScroll
          anchors.fill: parent
          padding: 5
          padding-right: 18
          vertical-scrollbar: detailScrollbar

          Panel
            id: scrollContent
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.right: parent.right
            layout:
              type: verticalBox
              spacing: 4
              fit-children: true

            Label
              id: chanceLabel
              height: 20
              color: #D7D7D7
              text-align: center
              visible: false

            Label
              id: durationLabel
              height: 20
              color: #D7D7D7
              text-align: center
              visible: false

            Label
              id: blockLabel
              height: 30
              color: #E86A6A
              text-align: center
              text-wrap: true
              visible: false

            Panel
              id: resultPanel
              height: 80
              background-color: #3B3B3B

              UIWidget
                id: resultIconBackground
                size: 52 52
                anchors.top: parent.top
                anchors.horizontalCenter: parent.horizontalCenter
                margin-top: 3
                image-source: /images/ui/item

                UIItem
                  id: resultIcon
                  anchors.centerIn: parent
                  size: 48 48
                  virtual: true
                  draggable: false

              Label
                id: resultName
                anchors.top: resultIconBackground.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                margin-top: 2
                height: 20
                color: #E0E0E0
                text-align: center
                text-wrap: true

            Panel
              id: detailList
              layout:
                type: verticalBox
                spacing: 3
                fit-children: true

            Panel
              id: quantityPanel
              height: 32
              visible: false

              Label
                id: quantityLabel
                anchors.left: parent.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 8
                width: 52
                color: #D7D7D7
                !text: tr('Quantity')

              Label
                id: quantityValueLabel
                anchors.left: quantityLabel.right
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 5
                width: 28
                color: #E0E0E0
                text-align: center
                text: 1

              HorizontalScrollBar
                id: quantitySlider
                anchors.left: quantityValueLabel.right
                anchors.right: quantityMaxButton.left
                anchors.verticalCenter: parent.verticalCenter
                margin-left: 7
                margin-right: 7
                minimum: 1
                maximum: 1
                value: 1
                step: 1
                @onValueChange: modules.game_crafting.onQuantityChange(self:getValue())

              Button
                id: quantityMaxButton
                size: 62 22
                anchors.right: parent.right
                anchors.verticalCenter: parent.verticalCenter
                margin-right: 8
                !text: tr('Max')
                @onClick: modules.game_crafting.selectMaxQuantity()

            Panel
              id: craftButtonPanel
              height: 30

              Button
                id: craftButton
                size: 112 24
                anchors.centerIn: parent
                !text: tr('Craft')
                enabled: false
                @onClick: modules.game_crafting.craftSelected()

            Label
              id: feedbackLabel
              height: 52
              margin-left: 8
              margin-right: 8
              color: #CFCFCF
              text-align: center
              text-wrap: true

        VerticalScrollBar
          id: detailScrollbar
          anchors.top: detailScroll.top
          anchors.right: detailScroll.right
          anchors.bottom: detailScroll.bottom
          step: 45
          pixel-scroll: true

    Panel
      id: queuePanel
      anchors.top: craftingTabs.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      background-color: #303030
      visible: false

      Label
        id: queueEmptyLabel
        anchors.centerIn: parent
        width: 300
        height: 48
        color: #999999
        text-align: center
        text-wrap: true
        !text: tr('No active crafting jobs')

      Panel
        id: jobPanel
        width: 520
        height: 132
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 24
        background-color: #3B3B3B
        visible: false

        Label
          id: jobTitle
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          height: 26
          color: #E0E0E0
          text-align: center
          !text: tr('Active crafting job')

        UIWidget
          id: jobIconBackground
          size: 58 58
          anchors.top: jobTitle.bottom
          anchors.left: parent.left
          margin-top: 7
          margin-left: 12
          image-source: /images/ui/item

          UIItem
            id: jobIcon
            anchors.centerIn: parent
            size: 52 52
            virtual: true
            draggable: false

        Label
          id: jobName
          anchors.top: jobTitle.bottom
          anchors.left: jobIconBackground.right
          anchors.right: parent.right
          margin-top: 5
          margin-left: 12
          margin-right: 12
          height: 22
          color: #E0E0E0
          text-align: left
          text-wrap: true

        Label
          id: jobStatus
          anchors.top: jobName.bottom
          anchors.left: jobName.left
          anchors.right: parent.right
          height: 20
          color: #E5B85C
          text-align: left

        ProgressBar
          id: jobProgress
          anchors.left: parent.left
          anchors.right: claimButton.left
          anchors.bottom: parent.bottom
          margin-left: 12
          margin-right: 10
          margin-bottom: 10
          height: 24
          background-color: #4B8F45
          color: #FFFFFF
          text-align: center

        Button
          id: claimButton
          size: 100 24
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-right: 12
          margin-bottom: 10
          !text: tr('Claim')
          enabled: false
          @onClick: modules.game_crafting.claimCraft()

      Label
        id: queueFeedbackLabel
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-left: 40
        margin-right: 40
        margin-bottom: 48
        height: 52
        color: #CFCFCF
        text-align: center
        text-wrap: true
        visible: false

  HorizontalSeparator
    id: bottomSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Button
    id: closeButton
    size: 76 22
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    !text: tr('Close')
    @onClick: modules.game_crafting.closeWindow()
